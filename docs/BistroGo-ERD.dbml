// BistroGo ERD - OC-9 Implement Database
// Paste into https://dbdiagram.io to render.
// Names match what EF Core will create (PascalCase, plural tables).
// Target: SQLite (bistrogo.db).

// ---------------------------------------------------------------
// Users & roles (ASP.NET Core Identity)
// Replaces the old staff_user table. A user can hold many roles
// (e.g. KitchenStaff who also orders as a customer).
// Only the columns we care about are shown; Identity adds more
// (SecurityStamp, LockoutEnd, etc.).
// ---------------------------------------------------------------

Table AspNetUsers {
  Id varchar(450) [pk, note: 'GUID string generated by Identity']
  FirstName varchar(100) [not null]
  LastName varchar(100) [not null]
  Email varchar(256) [unique]
  UserName varchar(256) [unique]
  PasswordHash text
  PhoneNumber varchar(20)
  CreatedAt datetime [not null, default: `CURRENT_TIMESTAMP`, note: 'NEW - carried over from staff_user.created_at']
  Note: 'The "User" table (ApplicationUser in code)'
}

Table AspNetRoles {
  Id varchar(450) [pk]
  Name varchar(256) [unique, note: 'Seeded: Guest, KitchenStaff, Manager']
  Note: 'The "Role" lookup table'
}

Table AspNetUserRoles {
  UserId varchar(450) [not null]
  RoleId varchar(450) [not null]
  indexes {
    (UserId, RoleId) [pk]
  }
  Note: 'The "UserRoles" join table - many-to-many between users and roles'
}

Ref: AspNetUserRoles.UserId > AspNetUsers.Id [delete: cascade]
Ref: AspNetUserRoles.RoleId > AspNetRoles.Id [delete: cascade]

// ---------------------------------------------------------------
// Menu
// ---------------------------------------------------------------

Table MenuCategories {
  Id int [pk, increment]
  Name varchar(50) [not null, unique]
  DisplayOrder int [not null, default: 0]
}

Table MenuItems {
  Id int [pk, increment]
  CategoryId int [not null]
  Name varchar(100) [not null]
  Description varchar(500)
  Price decimal(10,2) [not null, note: 'CHECK Price >= 0']
  IsAvailable boolean [not null, default: true]
  ImageUrl varchar(500)
  CreatedByUserId varchar(450) [note: 'was created_by_staff_id; nullable so deleting a user keeps the item']
}

Ref: MenuItems.CategoryId > MenuCategories.Id [delete: restrict]
Ref: MenuItems.CreatedByUserId > AspNetUsers.Id [delete: set null]

// ---------------------------------------------------------------
// Ordering
// ---------------------------------------------------------------

Table PickupTimeSlots {
  Id int [pk, increment]
  SlotDate date [not null]
  StartTime time [not null]
  EndTime time [not null, note: 'CHECK EndTime > StartTime']
  MaxOrders int [not null, default: 10]
  indexes {
    (SlotDate, StartTime) [unique]
  }
}

Table OrderStatuses {
  Id int [pk]
  Name varchar(30) [not null, unique]
  Note: 'NEW lookup table. Seeded: 1 Received, 2 Preparing, 3 Ready, 4 PickedUp, 5 Cancelled'
}

Table Orders {
  Id int [pk, increment]
  UserId varchar(450) [note: 'NEW - set when a logged-in user owns the order; null for guests']
  PickupSlotId int [note: 'now nullable - a cart has no slot yet']
  StatusId int [note: 'NEW FK, replaces status string; null while IsFinalized = 0']
  IsFinalized boolean [not null, default: false, note: 'NEW - 0 = shopping cart, 1 = placed order']
  GuestName varchar(100)
  GuestPhone varchar(20)
  GuestEmail varchar(256)
  Subtotal decimal(10,2) [not null, default: 0]
  Tax decimal(10,2) [not null, default: 0]
  Total decimal(10,2) [not null, default: 0]
  ConfirmationCode varchar(12) [unique, note: 'null until finalized']
  CreatedAt datetime [not null, default: `CURRENT_TIMESTAMP`, note: 'NEW - when the cart was started']
  PlacedAt datetime [note: 'now nullable - set when IsFinalized flips to 1']
  indexes {
    (UserId, IsFinalized) [name: 'IX_Orders_UserId_IsFinalized', note: 'fast "find my cart" lookup']
  }
}

Ref: Orders.UserId > AspNetUsers.Id [delete: set null]
Ref: Orders.PickupSlotId > PickupTimeSlots.Id [delete: restrict]
Ref: Orders.StatusId > OrderStatuses.Id [delete: restrict]

Table OrderItems {
  Id int [pk, increment]
  OrderId int [not null]
  MenuItemId int [not null]
  Quantity int [not null, default: 1, note: 'CHECK Quantity > 0']
  UnitPrice decimal(10,2) [not null, note: 'price snapshot at time of adding - menu prices can change later']
  SpecialInstructions varchar(250)
}

Ref: OrderItems.OrderId > Orders.Id [delete: cascade]
Ref: OrderItems.MenuItemId > MenuItems.Id [delete: restrict]

Table Ratings {
  Id int [pk, increment]
  OrderId int [not null]
  Stars int [not null, note: 'CHECK Stars BETWEEN 1 AND 5']
  Comment varchar(500)
  SubmittedAt datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Ref: Ratings.OrderId > Orders.Id [delete: cascade]

// ---------------------------------------------------------------
// Back office
// ---------------------------------------------------------------

Table Expenses {
  Id int [pk, increment]
  RecordedByUserId varchar(450) [not null, note: 'was recorded_by_staff_id']
  MenuItemId int [note: 'optional - expense tied to a specific item']
  Description varchar(250) [not null]
  Amount decimal(10,2) [not null, note: 'CHECK Amount >= 0']
  Category varchar(50) [not null]
  ExpenseDate date [not null]
}

Ref: Expenses.RecordedByUserId > AspNetUsers.Id [delete: restrict]
Ref: Expenses.MenuItemId > MenuItems.Id [delete: set null]

TableGroup Identity {
  AspNetUsers
  AspNetRoles
  AspNetUserRoles
}
