@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
}

<!-- ═══════════════════════════════════════════════════════════════
     HERO SECTION
     ═══════════════════════════════════════════════════════════════ -->
<div class="home-hero">
    <div class="home-hero-text">
        <h1 class="display-4 fw-bold mb-3">Welcome to BistroGo</h1>
        <p class="lead mb-4" style="color: #7a6a58;">
            Fresh ingredients, warm atmosphere, and your favorites ready to order.
        </p>
        <a asp-page="/Reviews/Index" class="btn btn-primary btn-lg px-4 py-2">
            ⭐ Check out some Reviews!
        </a>
    </div>
    <div class="home-hero-image">
        <span class="home-hero-image-placeholder">🍽️</span>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     OUR STORY SECTION
     ═══════════════════════════════════════════════════════════════ -->
<div class="row mt-5 align-items-center">
    <div class="col-md-6">
        <h2 class="mb-3">Our Story</h2>
        <p class="text-muted mb-3">
            BistroGo started with a simple idea: great food should be fast, fresh, and accessible to everyone.
            We source our ingredients locally every morning to ensure that every dish we serve is of the highest quality.
        </p>
        <p class="text-muted mb-3">
            Whether you're grabbing a quick bite on your lunch break or settling in for a cozy dinner,
            our kitchen staff is dedicated to making your experience memorable.
        </p>
        <div class="d-flex gap-3 mt-4">
            <div>
                <h3 class="card-price mb-0">100%</h3>
                <span class="text-muted small">Fresh Ingredients</span>
            </div>
            <div class="border-start mx-2"></div>
            <div>
                <h3 class="card-price mb-0">🌿</h3>
                <span class="text-muted small">Locally Sourced</span>
            </div>
            <div class="border-start mx-2"></div>
            <div>
                <h3 class="card-price mb-0">👨‍🍳</h3>
                <span class="text-muted small">Expert Chefs</span>
            </div>
        </div>
    </div>
    <div class="col-md-6 text-center">
        <!-- The main image container -->
        <div class="story-image-container">
            <img src="https://images.unsplash.com/photo-1790206391881-5600457b116f?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D" />
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     FEATURES / WHAT WE OFFER
     ═══════════════════════════════════════════════════════════════ -->
<div class="mt-5 pt-4">
    <h2 class="text-center mb-4">Why Choose BistroGo?</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 text-center p-4">
                <div class="display-5 mb-3">⚡</div>
                <h5 class="card-title">Fast Service</h5>
                <p class="text-muted small mb-0">Skip the line and order ahead. Your food will be hot and ready exactly when you need it.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center p-4">
                <div class="display-5 mb-3">🌱</div>
                <h5 class="card-title">Dietary Options</h5>
                <p class="text-muted small mb-0">From vegan to gluten-free, we have delicious options for every lifestyle and preference.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center p-4">
                <div class="display-5 mb-3">❤️</div>
                <h5 class="card-title">Made Fresh</h5>
                <p class="text-muted small mb-0">Every dish is crafted fresh daily, and cooked to order. Ensuring the best taste and quality for our customers.</p>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     CALL TO ACTION
     ═══════════════════════════════════════════════════════════════ -->
<div class="mt-5 p-5 text-center" style="background: linear-gradient(135deg, #fdfaf6 0%, #f5e6d3 100%); border-radius: 14px; border: 1px solid #e8d9c5;">
    <h2 class="mb-3">Hungry Yet?</h2>
    <p class="text-muted mb-4">Browse our menu and start building your perfect meal today.</p>
    <a asp-page="/Menu/Index" class="btn btn-primary btn-lg px-5">
        View Menu
    </a>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     ACCOUNT SHORTCUTS
     ═══════════════════════════════════════════════════════════════ -->
<div class="mt-5 pt-3 text-center">
    <p class="small text-muted">
        Already have an account?
        <a asp-page="/Account/Login" class="text-decoration-none" style="color: #b5651d;">Log in</a>
    </p>
    <p class="small text-muted">
        Don't have an account yet?
         <a asp-page="/Account/Register" class="text-decoration-none" style="color: #b5651d;">Register</a>
    </p>
</div>