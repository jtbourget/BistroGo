@page
@model BistroGo.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<h1>Log in</h1>

<form method="post" asp-route-returnUrl="@Request.Query["returnUrl"]" style="max-width: 420px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="Input.RememberMe" class="form-check-input" />
        <label asp-for="Input.RememberMe" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Log in</button>

    <p class="mt-3">
        New here?
        <a asp-page="/Account/Register" asp-route-returnUrl="@Request.Query["returnUrl"]">Create an account</a>
    </p>

    <p class="mt-3">
        Already have an account?
        <a asp-page="/Account/Login" asp-route-returnUrl="@Request.Query["returnUrl"]">Log in</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}