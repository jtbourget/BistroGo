@page
@model BistroGo.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<h1>Log in</h1>

@if (TempData["ResetMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["ResetMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post" asp-route-returnUrl="@Request.Query["returnUrl"]" style="max-width: 420px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">
            Password
            <span class="password-tooltip"
                  data-bs-toggle="tooltip"
                  data-bs-placement="right"
                  data-bs-html="true"
                  title="<strong>Password must have:</strong><br />• 8+ characters<br />• A–Z (uppercase)<br />• a–z (lowercase)<br />• 0–9 (number)">
                i
            </span>
        </label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="Input.RememberMe" class="form-check-input" />
        <label asp-for="Input.RememberMe" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Log in</button>

    <p class="mt-3">
        New here?
        <a asp-page="/Account/Register" asp-route-returnUrl="@Request.Query["returnUrl"]">Create an account</a>
    </p>

    <p class="mt-3">
        Already have an account?
        <a asp-page="/Account/Login" asp-route-returnUrl="@Request.Query["returnUrl"]">Log in</a>
    </p>
    <p class="mt-3">
    Forgot your password?
    <button type="button" class="btn btn-link p-0 align-baseline" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal"> Reset Password</button>
</p>
</form>

<!-- ═══════════════════════════════════════════════════════════════
     FORGOT PASSWORD MODAL
     ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-labelledby="forgotPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content menu-modal-content">

            <form method="post" asp-page-handler="ForgotPassword">
                <div class="modal-header">
                    <h5 class="modal-title" id="forgotPasswordModalLabel">Reset Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Enter the email associated with your account. If it matches,
                        we'll send a reset link.
                    </p>

                    <label for="resetEmail" class="form-label">Email address</label>
                    <input type="email" name="email" id="resetEmail"
                           class="form-control" placeholder="you@example.com" required />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Send Reset Link</button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/tooltips.js" asp-append-version="true"></script>
}