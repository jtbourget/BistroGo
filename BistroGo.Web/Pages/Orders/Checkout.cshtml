@page
@model BistroGo.Web.Pages.Orders.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<form id="csrfForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- MAIN CONTENT (Hidden when order succeeds) -->
<div id="checkoutMainContent">
    <div class="page-header">
        <h1>🧾 Checkout Confirmation</h1>
        <a asp-page="/Menu/Index" class="btn btn-outline-primary">← Back to Menu</a>
    </div>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <div class="row g-4">
        <!-- LEFT: Order review -->
        <div class="col-lg-7">
            <div class="dashboard-panel">
                <div class="dashboard-panel-header">
                    <h3>Your Order</h3>
                    <span class="text-muted small" id="checkoutItemCount">@Model.Lines.Sum(i => i.Quantity) items</span>
                </div>

                <div id="checkoutEmptyState" class="alert alert-info mb-0 @(Model.Lines.Any() ? "d-none" : "")">
                    Your cart is empty. <a asp-page="/Menu/Index">Browse the menu</a> to add items.
                </div>

                <table class="table align-middle mb-0 @(Model.Lines.Any() ? "" : "d-none")" id="checkoutTable">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-center" style="width: 160px;">Quantity</th>
                            <th class="text-end">Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="checkoutTableBody">
                        @foreach (var line in Model.Lines)
                        {
                            <tr data-menu-item-id="@line.MenuItemId">
                                <td>@line.MenuItem?.Name</td>
                                <td class="text-end">$@line.UnitPrice.ToString("0.00")</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary js-qty-decrease">−</button>
                                        <span class="px-2 align-self-center js-qty">@line.Quantity</span>
                                        <button type="button" class="btn btn-sm btn-outline-primary js-qty-increase">+</button>
                                    </div>
                                </td>
                                <td class="text-end js-line-total">$@((line.UnitPrice * line.Quantity).ToString("0.00"))</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 js-remove-line" title="Remove">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end text-muted">Subtotal:</td>
                            <td class="text-end" id="checkoutSubtotal">$@Model.Subtotal.ToString("0.00")</td>
                            <td></td>
                        </tr>
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr class="table-success">
                                <td colspan="3" class="text-end text-success">Employee Discount (20%):</td>
                                <td class="text-end text-success" id="checkoutDiscount">-$@Model.DiscountAmount.ToString("0.00")</td>
                                <td></td>
                            </tr>
                        }
                        <tr>
                            <td colspan="3" class="text-end text-muted">Tax:</td>
                            <td class="text-end" id="checkoutTax">$@Model.Tax.ToString("0.00")</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Total:</td>
                            <td class="text-end card-price" id="checkoutTotal">$@Model.Total.ToString("0.00")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- RIGHT: Customer details -->
        <div class="col-lg-5">
            <div class="dashboard-panel">
                <div class="dashboard-panel-header">
                    <h3>Your Details</h3>
                </div>

                <!-- Form doesn't submit normally; JS intercepts it -->
                <form id="checkoutForm">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input name="guestName" id="guestName" class="form-control" value="@Model.GuestName" placeholder="e.g. Alice Johnson" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone <span class="text-muted small">(optional)</span></label>
                        <input name="guestPhone" id="guestPhone" type="tel" class="form-control" value="@Model.GuestPhone" placeholder="555-0101" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email <span class="text-muted small">(optional)</span></label>
                        <input name="guestEmail" id="guestEmail" type="email" class="form-control" value="@Model.GuestEmail" placeholder="you@example.com" />
                    </div>

                    <fieldset class="mb-3">
                        <legend class="form-label fs-6">Pickup time</legend>

                        @if (Model.AvailableSlots.Any())
                        {
                            var today = DateOnly.FromDateTime(DateTime.Today);
                            var first = Model.AvailableSlots.First();
                            var firstDay = first.SlotDate == today ? "today" : first.SlotDate.ToString("ddd, MMM d");

                            <button type="button" id="asapBtn" class="btn btn-primary w-100 mb-1" aria-describedby="asapStatus">
                                ASAP
                            </button>
                            <div id="asapStatus" class="small text-muted mb-3" role="status" aria-live="polite">
                                Earliest available: @first.StartTime.ToString("h:mm tt") @firstDay
                            </div>

                            @foreach (var day in Model.AvailableSlots.GroupBy(s => s.SlotDate))
                            {
                                var heading = day.Key == today ? "Today"
                                            : day.Key == today.AddDays(1) ? "Tomorrow"
                                            : day.Key.ToString("dddd");
                                var groupLabel = $"{heading}, {day.Key:MMMM d}";

                                <div class="mb-3" role="group" aria-label="@groupLabel">
                                    <div class="small fw-semibold text-muted mb-1">
                                        @heading <span class="fw-normal">· @day.Key.ToString("MMM d")</span>
                                    </div>
                                    <div class="row row-cols-3 row-cols-sm-4 row-cols-lg-3 g-2">
                                        @foreach (var slot in day)
                                        {
                                            var inputId = $"slot-{slot.Id}";
                                            var slotLabel = $"{slot.StartTime:h:mm tt} {heading.ToLower()}";

                                            <div class="col">
                                                <input type="radio" class="btn-check" name="pickupSlotId" id="@inputId" value="@slot.Id"
                                                       data-label="@slotLabel" autocomplete="off"
                                                       checked="@(Model.PickupSlotId == slot.Id)" />
                                                <label class="btn btn-outline-primary btn-sm w-100 text-nowrap" for="@inputId">
                                                    @slot.StartTime.ToString("h:mm tt")
                                                    <span class="visually-hidden"> to @slot.EndTime.ToString("h:mm tt"), @groupLabel</span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div id="slotError" class="text-danger small d-none" role="alert">
                                Please choose a pickup time.
                            </div>
                        }
                        else
                        {
                            <button type="button" id="asapBtn" class="btn btn-primary w-100 mb-2" disabled aria-describedby="asapStatus">
                                ASAP
                            </button>
                            <div id="asapStatus" class="alert alert-warning mb-0" role="status">
                                No pickup times are available right now, so ASAP can't be used. Please check back soon.
                            </div>
                        }
                    </fieldset>

                    <div class="mb-3">
                        <label class="form-label">Notes for kitchen <span class="text-muted small">(optional)</span></label>
                        <textarea name="specialInstructions" id="specialInstructions" class="form-control" rows="2" placeholder="e.g. No onions">@Model.SpecialInstructions</textarea>
                    </div>

                    <!-- Button triggers the modal, doesn't submit directly -->
                    <button type="button" id="openConfirmModalBtn" class="btn btn-primary w-100 mb-2" disabled="@(!Model.Lines.Any() || !Model.AvailableSlots.Any())">
                        ✓ Place Order
                    </button>
                    <a asp-page="/Menu/Index" class="btn btn-outline-primary w-100">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- SUCCESS VIEW (Hidden by default) -->
<div id="checkoutSuccessView" class="d-none text-center mt-5">
    <div class="display-1 mb-3">🎉</div>
    <h1 class="mb-3">Order Placed!</h1>
    <p class="text-muted lead" id="successMessage">Your order has been received.</p>
    <div class="mt-4">
        <a asp-page="/Menu/Index" class="btn btn-primary btn-lg">Return to Menu</a>
    </div>
</div>

<!-- CONFIRMATION MODAL -->
<div class="modal fade" id="confirmOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content menu-modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-2 fs-5">Are you ready to place this order?</p>
                <p class="text-muted small mb-0">Total: <strong id="modalTotalDisplay">$0.00</strong></p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-primary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmPlaceOrderBtn" class="btn btn-primary px-4">Place Order</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tax-rate.js" asp-append-version="true"></script>
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}
