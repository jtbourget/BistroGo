@page
@model BistroGo.Web.Pages.Orders.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<form id="csrfForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- MAIN CONTENT (Hidden when order succeeds) -->
<div id="checkoutMainContent">
    <div class="page-header">
        <h1>🧾 Checkout Confirmation</h1>
        <a asp-page="/Menu/Index" class="btn btn-outline-primary">← Back to Menu</a>
    </div>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <div class="row g-4">
        <!-- LEFT: Order review -->
        <div class="col-lg-7">
            <div class="dashboard-panel">
                <div class="dashboard-panel-header">
                    <h3>Your Order</h3>
                    <span class="text-muted small" id="checkoutItemCount">@Model.Lines.Sum(i => i.Quantity) items</span>
                </div>

                <div id="checkoutEmptyState" class="alert alert-info mb-0 @(Model.Lines.Any() ? "d-none" : "")">
                    Your cart is empty. <a asp-page="/Menu/Index">Browse the menu</a> to add items.
                </div>

                <table class="table align-middle mb-0 @(Model.Lines.Any() ? "" : "d-none")" id="checkoutTable">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-center" style="width: 160px;">Quantity</th>
                            <th class="text-end">Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="checkoutTableBody">
                        @foreach (var line in Model.Lines)
                        {
                            <tr data-menu-item-id="@line.MenuItemId">
                                <td>@line.MenuItem?.Name</td>
                                <td class="text-end">$@line.UnitPrice.ToString("0.00")</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary js-qty-decrease">−</button>
                                        <span class="px-2 align-self-center js-qty">@line.Quantity</span>
                                        <button type="button" class="btn btn-sm btn-outline-primary js-qty-increase">+</button>
                                    </div>
                                </td>
                                <td class="text-end js-line-total">$@((line.UnitPrice * line.Quantity).ToString("0.00"))</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 js-remove-line" title="Remove">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end text-muted">Subtotal:</td>
                            <td class="text-end" id="checkoutSubtotal">$@Model.Subtotal.ToString("0.00")</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end text-muted">Tax:</td>
                            <td class="text-end" id="checkoutTax">$@Model.Tax.ToString("0.00")</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Total:</td>
                            <td class="text-end card-price" id="checkoutTotal">$@Model.Total.ToString("0.00")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- RIGHT: Customer details -->
        <div class="col-lg-5">
            <div class="dashboard-panel">
                <div class="dashboard-panel-header">
                    <h3>Your Details</h3>
                </div>

                <!-- Form doesn't submit normally; JS intercepts it -->
                <form id="checkoutForm">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input name="guestName" id="guestName" class="form-control" placeholder="e.g. Alice Johnson" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone <span class="text-muted small">(optional)</span></label>
                        <input name="guestPhone" id="guestPhone" type="tel" class="form-control" placeholder="555-0101" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email <span class="text-muted small">(optional)</span></label>
                        <input name="guestEmail" id="guestEmail" type="email" class="form-control" placeholder="you@example.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Notes for kitchen <span class="text-muted small">(optional)</span></label>
                        <textarea name="specialInstructions" id="specialInstructions" class="form-control" rows="2" placeholder="e.g. No onions"></textarea>
                    </div>

                    <!-- Button triggers the modal, doesn't submit directly -->
                    <button type="button" id="openConfirmModalBtn" class="btn btn-primary w-100 mb-2" disabled="@(!Model.Lines.Any())">
                        ✓ Place Order
                    </button>
                    <a asp-page="/Menu/Index" class="btn btn-outline-primary w-100">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- SUCCESS VIEW (Hidden by default) -->
<div id="checkoutSuccessView" class="d-none text-center mt-5">
    <div class="display-1 mb-3">🎉</div>
    <h1 class="mb-3">Order Placed!</h1>
    <p class="text-muted lead" id="successMessage">Your order has been received.</p>
    <div class="mt-4">
        <a asp-page="/Menu/Index" class="btn btn-primary btn-lg">Return to Menu</a>
    </div>
</div>

<!-- CONFIRMATION MODAL -->
<div class="modal fade" id="confirmOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content menu-modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-2 fs-5">Are you ready to place this order?</p>
                <p class="text-muted small mb-0">Total: <strong id="modalTotalDisplay">$0.00</strong></p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-primary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmPlaceOrderBtn" class="btn btn-primary px-4">Place Order</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const csrfToken = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]')?.value || '';
            const confirmModal = new bootstrap.Modal(document.getElementById('confirmOrderModal'));

            // Cart Editing (- / + / ✕)
            const tableBody = document.getElementById('checkoutTableBody');
            const table = document.getElementById('checkoutTable');
            const emptyState = document.getElementById('checkoutEmptyState');
            const subtotalEl = document.getElementById('checkoutSubtotal');
            const taxEl = document.getElementById('checkoutTax');
            const totalEl = document.getElementById('checkoutTotal');
            const itemCountEl = document.getElementById('checkoutItemCount');

            if (tableBody) {
                tableBody.addEventListener('click', async function (e) {
                    const row = e.target.closest('tr');
                    if (!row) return;

                    const menuItemId = parseInt(row.getAttribute('data-menu-item-id'), 10);
                    const qtySpan = row.querySelector('.js-qty');
                    const currentQty = parseInt(qtySpan.textContent, 10);

                    let endpoint = null;
                    let body = null;

                    if (e.target.classList.contains('js-qty-increase')) {
                        endpoint = '?handler=UpdateQuantityJson';
                        body = new URLSearchParams({ menuItemId, quantity: currentQty + 1 });
                    } else if (e.target.classList.contains('js-qty-decrease')) {
                        endpoint = '?handler=UpdateQuantityJson';
                        body = new URLSearchParams({ menuItemId, quantity: currentQty - 1 });
                    } else if (e.target.classList.contains('js-remove-line')) {
                        endpoint = '?handler=RemoveLineJson';
                        body = new URLSearchParams({ menuItemId });
                    }

                    if (!endpoint) return;

                    const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': csrfToken
                        },
                        body: body.toString()
                    });

                    if (!response.ok) return;

                    const data = await response.json();

                    const hasLines = data.lines.length > 0;
                    table.classList.toggle('d-none', !hasLines);
                    emptyState.classList.toggle('d-none', hasLines);

                    tableBody.innerHTML = '';
                    for (const line of data.lines) {
                        const tr = document.createElement('tr');
                        tr.setAttribute('data-menu-item-id', line.menuItemId);
                        tr.innerHTML = `
                                    <td>${escapeHtml(line.itemName)}</td>
                                    <td class="text-end">$${line.unitPrice.toFixed(2)}</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary js-qty-decrease">−</button>
                                            <span class="px-2 align-self-center js-qty">${line.quantity}</span>
                                            <button type="button" class="btn btn-sm btn-outline-primary js-qty-increase">+</button>
                                        </div>
                                    </td>
                                    <td class="text-end js-line-total">$${line.total.toFixed(2)}</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 js-remove-line" title="Remove">✕</button>
                                    </td>`;
                        tableBody.appendChild(tr);
                    }

                    subtotalEl.textContent = '$' + data.subtotal.toFixed(2);
                    taxEl.textContent = '$' + data.tax.toFixed(2);
                    totalEl.textContent = '$' + data.total.toFixed(2);
                    itemCountEl.textContent = data.itemCount + ' items';

                    // Sync the sidebar and menu badges to reflect the change
                    const ticker = document.getElementById('cartTicker');
                    if (ticker) {
                        ticker.textContent = data.itemCount;
                        ticker.classList.toggle('d-none', data.itemCount === 0);
                    }
                    const menuBadge = document.getElementById('menuCartBadge');
                    if (menuBadge) {
                        menuBadge.textContent = data.itemCount;
                        menuBadge.classList.toggle('d-none', data.itemCount === 0);
                    }

                    // Disable Place Order if cart becomes empty
                    const openBtn = document.getElementById('openConfirmModalBtn');
                    if (openBtn) openBtn.disabled = !hasLines;
                });
            }

            function escapeHtml(str) {
                const div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            const openModalBtn = document.getElementById('openConfirmModalBtn');
            const submitBtn = document.getElementById('confirmPlaceOrderBtn');
            const checkoutForm = document.getElementById('checkoutForm');

            // ── Open Modal ──────────────────────────────────────────────
            openModalBtn?.addEventListener('click', function () {
                // Basic validation before opening
                if (!checkoutForm.checkValidity()) {
                    checkoutForm.reportValidity();
                    return;
                }
                // Set the total in the modal text
                document.getElementById('modalTotalDisplay').textContent = document.getElementById('checkoutTotal').textContent;
                confirmModal.show();
            });

            // ── Submit Order via AJAX ───────────────────────────────────
            submitBtn?.addEventListener('click', async function () {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...';

                const formData = new FormData(checkoutForm);
                const body = new URLSearchParams(formData);

                try {
                    const response = await fetch('?handler=PlaceOrderJson', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': csrfToken
                        },
                        body: body.toString()
                    });

                    const data = await response.json();

                    if (data.success) {
                        confirmModal.hide();

                        // Hide form, show success screen
                        document.getElementById('checkoutMainContent').classList.add('d-none');
                        document.getElementById('checkoutSuccessView').classList.remove('d-none');

                        if (data.orderId) {
                            document.getElementById('successMessage').textContent = `Order #${data.orderId} has been received. We'll have it ready shortly!`;
                        }

                        // Sync the sidebar and menu badges to 0
                        const ticker = document.getElementById('cartTicker');
                        if (ticker) ticker.classList.add('d-none');
                        const menuBadge = document.getElementById('menuCartBadge');
                        if (menuBadge) menuBadge.classList.add('d-none');
                    } else {
                        alert(data.message || 'Failed to place order.');
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Place Order';
                    }
                } catch (err) {
                    console.error(err);
                    alert('An error occurred. Please try again.');
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Place Order';
                }
            });
        });
    </script>
}