@page
@model BistroGo.Web.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Orders";
}

<div class="page-header">
    <h1>📋 Cook Dashboard</h1>
    <span class="text-muted">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">

    <!-- ═══════════════════════════════════════════════════════════
         COLUMN 1 — CURRENT ORDERS
         ═══════════════════════════════════════════════════════════ -->
    <div class="col-lg-4">
        <div class="dashboard-panel">
            <div class="dashboard-panel-header">
                <h3>Current Orders</h3>
            </div>

            @if (!Model.CurrentOrders.Any())
            {
                <div class="dashboard-empty">
                    No open orders. <a asp-page="/Menu/Index">Start one from the menu</a>.
                </div>
            }
            else
            {
                <div class="dashboard-list">
                    @foreach (var order in Model.CurrentOrders)
                    {
                        var badgeClass = order.Status switch
                        {
                            "Received" => "badge-reserved",
                            "Preparing" => "badge-occupied",
                            "Ready" => "badge-available",
                            "PickedUp" => "bg-secondary",
                            _ => "bg-secondary"
                        };

                        <div class="thin-card">
                            <span class="thin-card-icon">🧾</span>
                            <span class="thin-card-body">
                                <span class="thin-card-title">#@order.Id — @order.CustomerName</span>
                                <span class="thin-card-sub">Table @order.TableNumber · @order.PlacedAt.ToString("h:mm tt")</span>
                            </span>
                            <span class="thin-card-meta">

                                <!--
                                    This form posts directly to OnPostSetStatusAsync in the C# code.
                                    It will update the SQLite database and reload the page.
                                -->
                                <form method="post" asp-page-handler="SetStatus" class="d-flex align-items-center gap-1 mb-0">
                                    <input type="hidden" name="id" value="@order.Id" />

                                    <!-- The options match the if/else checks in OnPostSetStatusAsync -->
                                    <select name="status" class="form-select form-select-sm badge @badgeClass border-0"
                                            onchange="this.form.submit()"
                                            style="cursor: pointer; width: auto; font-weight: 600;">
                                        <option value="Received" selected="@(order.Status == "Received")">Received</option>
                                        <option value="Preparing" selected="@(order.Status == "Preparing")">Preparing</option>
                                        <option value="Ready" selected="@(order.Status == "Ready")">Ready</option>
                                    </select>
                                </form>

                                <span class="card-price ms-2">$@order.Total.ToString("0.00")</span>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         COLUMN 2 — TABLES
         ═══════════════════════════════════════════════════════════ -->
    <div class="col-lg-4">
        <div class="dashboard-panel">
            <div class="dashboard-panel-header">
                <h3>Tables</h3>
            </div>

            <div class="dashboard-list">
                @foreach (var t in Model.Tables)
                {
                    var badgeClass = t.Status switch
                    {
                        "Available" => "badge-available",
                        "Occupied" => "badge-occupied",
                        "Reserved" => "badge-reserved",
                        _ => "bg-secondary"
                    };
                    <div class="thin-card">
                        <span class="thin-card-icon">🪑</span>
                        <span class="thin-card-body">
                            <span class="thin-card-title">Table @t.Number</span>
                        </span>
                        <span class="thin-card-meta">
                            <span class="badge @badgeClass">@t.Status</span>
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         COLUMN 3 — CUSTOMERS
         ═══════════════════════════════════════════════════════════ -->
    <div class="col-lg-4">
        <div class="dashboard-panel">
            <div class="dashboard-panel-header">
                <h3>Customers</h3>
            </div>

            @if (!Model.Customers.Any())
            {
                <div class="dashboard-empty">No customers yet.</div>
            }
            else
            {
                <div class="dashboard-list">
                    @foreach (var c in Model.Customers)
                    {
                        <div class="thin-card">
                            <span class="thin-card-icon">👤</span>
                            <span class="thin-card-body">
                                <span class="thin-card-title">@c.Name</span>
                                <span class="thin-card-sub">@c.Phone</span>
                            </span>
                            <span class="thin-card-meta">
                                <span class="text-muted small">@c.VisitCount visits</span>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/orders.js" asp-append-version="true"></script>
}