@page
@model BistroGo.Web.Pages.Orders.IndexModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Orders";

    // Lets the first-visit prompt below be remembered separately for each staff member on a shared device.
    string? currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="page-header flex-wrap gap-2">
    <h1>📋 Cook Dashboard</h1>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="text-muted">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
        <!-- Starts (or restarts) the guided tour of this page; see wwwroot/js/kitchen-walkthrough.js -->
        <button type="button" id="startKitchenWalkthroughBtn" class="btn btn-sm btn-outline-primary" data-tour="walkthrough-button">
            🧭 Kitchen Walkthrough
        </button>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">

    <!-- ═══════════════════════════════════════════════════════════
         CURRENT ORDERS
         ═══════════════════════════════════════════════════════════ -->
    <div class="col-12">
        <div class="dashboard-panel">
            <div class="dashboard-panel-header d-flex justify-content-between align-items-center mb-2">
                <h3>Current Orders</h3>
                <span class="badge bg-primary">@Model.CurrentOrders.Count</span>
            </div>

            <!-- Status Filter Tabs -->
            <div class="btn-group btn-group-sm mb-3 w-100" role="group" data-tour="status-filters">
                <a asp-page="/Orders/Index" asp-route-statusFilter="" class="btn @(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "All" ? "btn-primary" : "btn-outline-primary")">All (@Model.AllCount)</a>
                <a asp-page="/Orders/Index" asp-route-statusFilter="Received" class="btn @(Model.StatusFilter == "Received" ? "btn-primary" : "btn-outline-primary")">New (@Model.ReceivedCount)</a>
                <a asp-page="/Orders/Index" asp-route-statusFilter="Preparing" class="btn @(Model.StatusFilter == "Preparing" ? "btn-primary" : "btn-outline-primary")">Prep (@Model.PreparingCount)</a>
                <a asp-page="/Orders/Index" asp-route-statusFilter="Ready" class="btn @(Model.StatusFilter == "Ready" ? "btn-primary" : "btn-outline-primary")">Ready (@Model.ReadyCount)</a>
                <a asp-page="/Orders/Index" asp-route-statusFilter="PickedUp" class="btn @(Model.StatusFilter == "PickedUp" ? "btn-primary" : "btn-outline-primary")">Done (@Model.PickedUpCount)</a>
            </div>

            @if (!Model.CurrentOrders.Any())
            {
                <div class="dashboard-empty" data-tour="order-empty">
                    No orders matching this view. <a asp-page="/Menu/Index">Start one from the menu</a>.
                </div>
            }
            else
            {
                <div class="dashboard-list">
                    @foreach (var order in Model.CurrentOrders)
                    {
                        var badgeClass = order.Status switch
                        {
                            "Received" => "badge-reserved",
                            "Preparing" => "badge-occupied",
                            "Ready" => "badge-available",
                            "PickedUp" => "bg-secondary text-white",
                            "Cancelled" => "bg-danger text-white",
                            _ => "bg-secondary text-white"
                        };

                        var shadowClass = order.Status switch
                        {
                            "Received" => "status-received",
                            "Preparing" => "status-preparing",
                            "Ready" => "status-ready",
                            _ => ""
                        };

                        <div class="thin-card mb-3 flex-column align-items-stretch p-3" data-tour="order-card">
                            <div class="d-flex align-items-center justify-content-between mb-2" data-tour="order-header">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="thin-card-icon">🧾</span>
                                    <div>
                                        <span class="thin-card-title d-block fs-6">#@order.Id — @order.CustomerName</span>
                                        <span class="thin-card-sub text-muted">@(order.PickupTime != null ? $"Pickup at {order.PickupTime} · " : (order.PickupSlotId.HasValue ? $"Pickup Slot #{order.PickupSlotId} · " : ""))Placed at @order.PlacedAt.ToString("h:mm tt")</span>
                                        @if (!string.IsNullOrEmpty(order.ConfirmationCode))
                                        {
                                            <span class="badge bg-light text-dark border ms-1 small">@order.ConfirmationCode</span>
                                        }
                                    </div>
                                </div>
                                <span class="card-price fs-6 fw-bold">$@order.Total.ToString("0.00")</span>
                            </div>

                            <!-- Order Items Section for Kitchen Staff -->
                            <div class="order-items-box bg-light p-2 rounded mb-2 border" style="font-size: 0.85rem;" data-tour="order-items">
                                @if (order.Items.Any())
                                {
                                    @foreach (var item in order.Items)
                                    {
                                        <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light">
                                            <span><strong>@(item.Quantity)x</strong> @item.MenuItemName</span>
                                            <span class="text-muted">$@((item.UnitPrice * item.Quantity).ToString("0.00"))</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.SpecialInstructions))
                                        {
                                            <div class="text-danger small fst-italic ps-2 pb-1">
                                                ⚠️ Note: @item.SpecialInstructions
                                            </div>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">No items recorded for this order.</span>
                                }
                            </div>

                            <!-- Status Dropdown & Action Controls -->
                            <div class="d-flex justify-content-between align-items-center">
                                <form method="post" asp-page-handler="SetStatus" class="d-flex align-items-center mb-0">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <div class="status-dropdown-wrapper @shadowClass" data-tour="order-status">
                                        <span class="badge @badgeClass">@order.Status</span>
                                        <select name="status" class="status-dropdown" onchange="this.form.submit()">
                                            <option value="Received" selected="@(order.Status == "Received")">Received</option>
                                            <option value="Preparing" selected="@(order.Status == "Preparing")">Preparing</option>
                                            <option value="Ready" selected="@(order.Status == "Ready")">Ready</option>
                                            <option value="PickedUp" selected="@(order.Status == "PickedUp")">Picked Up / Completed</option>
                                            <option value="Cancelled" selected="@(order.Status == "Cancelled")">Cancelled</option>
                                        </select>
                                    </div>
                                </form>

                                @if (order.Status != "PickedUp" && order.Status != "Cancelled")
                                {
                                    <form method="post" asp-page-handler="Complete" class="mb-0">
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success" data-tour="order-complete">✓ Complete</button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Shown by kitchen-walkthrough.js when staff click Finish on the last step of the tour.
     Hidden until then; fixed to the bottom-right so it doesn't cover the order queue. -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="kitchenWalkthroughCompleteToast" class="toast" role="status" aria-live="polite" aria-atomic="true" data-bs-delay="6000">
        <div class="toast-header">
            <strong class="me-auto">✅ Walkthrough complete</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            You've finished the kitchen walkthrough. Click <strong>Kitchen Walkthrough</strong> at the top of this page anytime to run it again.
        </div>
    </div>
</div>

@*
    First-visit prompt (OC-11): offers the kitchen walkthrough the first time each cook or manager
    opens this dashboard on this device. Shown by wwwroot/js/first-visit.js, which clicks the
    Kitchen Walkthrough button above when they accept.
*@
@if (User.IsInRole(Roles.KitchenStaff) || User.IsInRole(Roles.Manager))
{
    <div class="modal fade" id="kitchenWalkthroughPromptModal" tabindex="-1" aria-labelledby="kitchenWalkthroughPromptTitle" aria-hidden="true"
         data-first-visit-prompt
         data-storage-key="bistroGo_kitchenTourPrompted"
         data-user-id="@currentUserId"
         data-start-button="startKitchenWalkthroughBtn">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="kitchenWalkthroughPromptTitle">🧭 New to the Cook Dashboard?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Take a quick guided tour to learn how to read incoming orders and update their status.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No thanks</button>
                    <button type="button" class="btn btn-primary" data-first-visit-accept>Start the tour</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/orders.js" asp-append-version="true"></script>
    <script src="~/js/kitchen-walkthrough.js" asp-append-version="true"></script>
}
