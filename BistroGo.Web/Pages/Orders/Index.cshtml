@page
@model BistroGo.Web.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Orders";
}

<div class="page-header">
    <h1>📋 Cook Dashboard</h1>
    <span class="text-muted">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
</div>

<div class="row g-4">

    <!-- ═══════════════════════════════════════════════════════════
         COLUMN 1 — CURRENT ORDERS
         ═══════════════════════════════════════════════════════════ -->
    <div class="col-lg-4">
        <div class="dashboard-panel">
            <div class="dashboard-panel-header">
                <h3>Current Orders</h3>
            </div>

            @if (!Model.CurrentOrders.Any())
            {
                <div class="dashboard-empty">
                    No open orders. <a asp-page="/Menu/Index">Start one from the menu</a>.
                </div>
            }
            else
            {
                <div class="dashboard-list">
                    @foreach (var order in Model.CurrentOrders)
                    {
                        // 1. Determine the badge color based on the current status from the database
                        var badgeClass = order.Status switch
                        {
                            "Received" => "badge-reserved",
                            "Preparing" => "badge-occupied",
                            "Ready" => "badge-available",
                            _ => "bg-secondary"
                        };

                        // 2. Determine the glow/shadow effect based on the status
                        var shadowClass = order.Status switch
                        {
                            "Received" => "status-received",
                            "Preparing" => "status-preparing",
                            "Ready" => "status-ready",
                            _ => ""
                        };

                        <div class="thin-card">
                            <span class="thin-card-icon">🧾</span>
                            <span class="thin-card-body">
                                <!--
                                    The Order Data (ID, Customer Name, Table, Time, Total)
                                    is populated directly from the SQLite database via
                                    Entity Framework in Index.cshtml.cs -> LoadDataAsync().
                                -->
                                <span class="thin-card-title">#@order.Id — @order.CustomerName</span>
                                <span class="thin-card-sub">Table @order.TableNumber · @order.PlacedAt.ToString("h:mm tt")</span>
                            </span>
                            <span class="thin-card-meta">

                                <!--
                                    API INTEGRATION NOTE:
                                    When you move to the API, this form will be intercepted by JavaScript.
                                    Instead of a page reload, the JS will send a PUT request to something like:
                                    /api/orders/{id}/status
                                    with the new status string in the body.
                                -->
                                <form method="post" asp-page-handler="SetStatus" class="d-flex align-items-center mb-0">
                                    <!-- The ID of the order we are updating is sent securely in the form payload -->
                                    <input type="hidden" name="id" value="@order.Id" />

                                    <!-- The Wrapper with the dynamic shadow class -->
                                    <div class="status-dropdown-wrapper @shadowClass">

                                        <!-- The colored badge (user sees this) -->
                                        <span class="badge @badgeClass">@order.Status</span>

                                        <!--
                                            THE INVISIBLE DROPDOWN
                                            When the user changes this select, 'onchange' fires.
                                            'this.form.submit()' sends a POST request to the server.
                                            In Index.cshtml.cs, the 'OnPostSetStatusAsync' handler catches it,
                                            updates the StatusId in the SQLite database, and reloads the page.
                                        -->
                                        <select name="status" class="status-dropdown" onchange="this.form.submit()">
                                            <option value="Received" selected="@(order.Status == "Received")">Received</option>
                                            <option value="Preparing" selected="@(order.Status == "Preparing")">Preparing</option>
                                            <option value="Ready" selected="@(order.Status == "Ready")">Ready</option>
                                        </select>

                                    </div>
                                </form>

                                <span class="card-price ms-2">$@order.Total.ToString("0.00")</span>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════
         COLUMN 2 — TABLES
         ═══════════════════════════════════════════════════════════ -->
    <div class="col-lg-4">
        <div class="dashboard-panel">
            <div class="dashboard-panel-header">
                <h3>Tables</h3>
            </div>

            <div class="dashboard-list">
                @foreach (var t in Model.Tables)
                {
                    var badgeClass = t.Status switch
                    {
                        "Available" => "badge-available",
                        "Occupied" => "badge-occupied",
                        "Reserved" => "badge-reserved",
                        _ => "bg-secondary"
                    };
                    <div class="thin-card">
                        <span class="thin-card-icon">🪑</span>
                        <span class="thin-card-body">
                            <span class="thin-card-title">Table @t.Number</span>
                        </span>
                        <span class="thin-card-meta">
                            <span class="badge @badgeClass">@t.Status</span>
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         COLUMN 3 — CUSTOMERS
         ═══════════════════════════════════════════════════════════ -->
    <div class="col-lg-4">
        <div class="dashboard-panel">
            <div class="dashboard-panel-header">
                <h3>Customers</h3>
            </div>

            @if (!Model.Customers.Any())
            {
                <div class="dashboard-empty">No customers yet.</div>
            }
            else
            {
                <div class="dashboard-list">
                    @foreach (var c in Model.Customers)
                    {
                        <div class="thin-card">
                            <span class="thin-card-icon">👤</span>
                            <span class="thin-card-body">
                                <span class="thin-card-title">@c.Name</span>
                                <span class="thin-card-sub">@c.Phone</span>
                            </span>
                            <span class="thin-card-meta">
                                <span class="text-muted small">@c.VisitCount visits</span>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/orders.js" asp-append-version="true"></script>
}