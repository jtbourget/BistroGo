@page
@model BistroGo.Web.Pages.Inventory.IndexModel
@{
    ViewData["Title"] = "Inventory";
}

<div class="page-header">
    <h1>📦 Manage Inventory</h1>

</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- LEFT COLUMN: Menu Items -->
    <div class="col-lg-8">
        <h3>Menu Items (@Model.Items.Count)
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newItemModal">+ New Item</button>
        </h3>

        @if (!Model.Items.Any())
        {
            <div class="alert alert-info">No menu items yet. Click "New Item" to add one.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var item in Model.Items)
                {
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h5 class="card-title mb-0">@item.Name</h5>
                                    <button type="button"
                                            class="btn btn-sm btn-link text-danger p-0"
                                            title="Delete"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteConfirmationModal"
                                            data-item-id="@item.Id"
                                            data-item-name="@item.Name">
                                        ✕
                                    </button>
                                </div>
                                <span class="badge bg-secondary menu-category-badge mb-2">@item.Category</span>
                                <p class="text-muted small flex-grow-1 mb-2">@item.Description</p>
                                <span class="card-price">$@item.Price.ToString("0.00")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- RIGHT COLUMN: Categories -->
    <div class="col-lg-4">
        <h3>Categories (@Model.Categories.Count)</h3>

        <div class="card mb-3">
            <div class="card-body">
                <form method="post" asp-page-handler="AddCategory" class="d-flex gap-2">
                    <input type="text"
                           name="NewCategoryName"
                           class="form-control"
                           placeholder="New category name"
                           maxlength="40"
                           required />
                    <button type="submit" class="btn btn-primary">Add</button>
                </form>
            </div>
        </div>

        @if (!Model.Categories.Any())
        {
            <div class="alert alert-info">No categories yet.</div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var cat in Model.Categories)
                {
                    var count = Model.Items.Count(i => i.Category == cat.Name);
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            <strong>@cat.Name</strong>
                            <span class="text-muted small ms-2">(@count)</span>
                        </span>
                        <form method="post" asp-page-handler="DeleteCategory"
                              onsubmit="return confirm('Delete category @cat.Name and its items?');">
                            <input type="hidden" name="id" value="@cat.Id" />
                            <button type="submit" class="btn btn-sm btn-link text-danger p-0">✕</button>
                        </form>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<partial name="Shared/DeleteConfirmation" />

<!-- NEW ITEM MODAL -->
<div class="modal fade" id="newItemModal" tabindex="-1" aria-labelledby="newItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content menu-modal-content">
            <form method="post" asp-page-handler="AddItem">
                <div class="modal-header">
                    <h5 class="modal-title" id="newItemModalLabel">+ New Menu Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="NewItem.Name" class="form-label">Name</label>
                        <input asp-for="NewItem.Name" class="form-control" required maxlength="80" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewItem.Description" class="form-label">Description</label>
                        <textarea asp-for="NewItem.Description" class="form-control" rows="2" maxlength="200"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NewItem.Price" class="form-label">Price ($)</label>
                            <input asp-for="NewItem.Price" type="number" step="0.01" min="0" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NewItem.Category" class="form-label">Category</label>
                            <select asp-for="NewItem.Category" class="form-select" required>
                                <option value="">Select...</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Name">@cat.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-0">
                        <label asp-for="NewItem.ImageUrl" class="form-label">Image URL (optional)</label>
                        <input asp-for="NewItem.ImageUrl" class="form-control" placeholder="https://..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Item</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteItemId = document.getElementById('deleteItemId');
            const deleteItemName = document.getElementById('deleteItemName');

            document.querySelectorAll('[data-bs-target="#deleteConfirmationModal"]').forEach(function (button) {
                button.addEventListener('click', function () {
                    deleteItemId.value = this.dataset.itemId;
                    deleteItemName.textContent = this.dataset.itemName;
                });
            });

            @if (ViewData["OpenModal"] as bool? == true)
            {
                <text>
                new bootstrap.Modal(document.getElementById('newItemModal')).show();
                </text>
            }
        });
    </script>
}