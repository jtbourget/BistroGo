@model BistroGo.Web.ViewComponents.CartViewModel

<div class="modal fade" id="currentOrderModal" tabindex="-1" aria-labelledby="currentOrderModalLabel" aria-hidden="true"> <!-- aria is for screen readers-->
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content menu-modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="currentOrderModalLabel">Current Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-end">Price</th>
                            <th class="text-center" style="width: 160px;">Quantity</th>
                            <th class="text-end">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Lines.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">Your cart is empty.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td>@line.MenuItem!.Name</td>
                                    <td class="text-end">$@line.UnitPrice.ToString("0.00")</td>
                                    <td class="text-center">@line.Quantity</td>
                                    <td class="text-end">$@((line.Quantity * line.UnitPrice).ToString("0.00"))</td>
                                    <td class="text-end text-muted">✕</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Total:</td>
                            <td class="text-end card-price">$@Model.Total.ToString("0.00")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Close</button>
                <a asp-page="/Orders/Create" class="btn btn-primary">Continue to Checkout</a>
            </div>
        </div>
    </div>
</div>