<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BistroGo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BistroGo.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">

        <!-- ── Sidebar ─────────────────────────────────── -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <a asp-page="/Index" class="brand-link">
                    <span class="brand-emblem">🍽️</span>
                    <span class="brand-text">Bistro<span class="brand-accent">Go</span></span>
                </a>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a asp-page="/Index" class="nav-link">
                            <span class="nav-icon">🏠</span> Home
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Menu/Index" class="nav-link">
                            <span class="nav-icon">🍴</span> Menu
                        </a>
                    </li>
                    <!-- 
                        Shopping Cart Sidebar Item 
                        Displays the current total items added to the cart via the global CartCount.
                        Clicking this item triggers the globally accessible currentOrderModal. 
                    -->
                    <li>
                        <a href="#" class="nav-link" data-bs-toggle="modal" data-bs-target="#currentOrderModal">
                            <span class="nav-icon">🛒</span> Cart
                            <span class="badge bg-danger rounded-pill ms-2" id="cartTicker">@BistroGo.Web.Pages.Inventory.MenuStore.CartCount</span>
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Orders/Index" class="nav-link">
                            <span class="nav-icon">📋</span> Orders
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Tables/Index" class="nav-link">
                            <span class="nav-icon">🪑</span> Tables
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Customers/Index" class="nav-link">
                            <span class="nav-icon">👤</span> Customers
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Inventory/Index" class="nav-link">
                            <span class="nav-icon">📦</span> Manage Inventory
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <small>&copy; @DateTime.Now.Year BistroGo</small>
            </div>
        </aside>

        <!-- ── Main content area ───────────────────────── -->
        <div class="main-area">
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">☰</button>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- 
        Global Current Order Modal 
        Contains the shopping cart functionality and details.
        Moved to the shared layout so it can be invoked from any page via the Cart sidebar item.
    -->
    <div class="modal fade" id="currentOrderModal" tabindex="-1" aria-labelledby="currentOrderModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content menu-modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="currentOrderModalLabel">Current Order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="text-end">Price</th>
                                <th class="text-center" style="width: 160px;">Quantity</th>
                                <th class="text-end">Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!BistroGo.Web.Pages.Inventory.MenuStore.CartItems.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">Your cart is empty.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var cartItem in BistroGo.Web.Pages.Inventory.MenuStore.CartItems)
                                {
                                    <tr>
                                        <td>@cartItem.Name</td>
                                        <td class="text-end">$@cartItem.Price.ToString("0.00")</td>
                                        <td class="text-center">@cartItem.Quantity</td>
                                        <td class="text-end">$@cartItem.Total.ToString("0.00")</td>
                                        <td class="text-end text-muted">✕</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Total:</td>
                                <td class="text-end card-price">$@BistroGo.Web.Pages.Inventory.MenuStore.CartItems.Sum(c => c.Total).ToString("0.00")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Close</button>
                    <a asp-page="/Orders/Create" class="btn btn-primary">Continue to Checkout</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            // Toggle sidebar on mobile
            document.getElementById('sidebarToggle')?.addEventListener('click', function () {
                document.querySelector('.app-wrapper').classList.toggle('sidebar-collapsed');
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>