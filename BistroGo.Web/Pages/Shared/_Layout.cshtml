<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BistroGo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BistroGo.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">

        <!-- ── Sidebar ─────────────────────────────────── -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <a asp-page="/Index">BistroGo</a>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a asp-page="/Index" class="nav-link">
                            <span class="nav-icon">🏠</span> Home
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Menu/Index" class="nav-link">
                            <span class="nav-icon">🍴</span> Menu
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Orders/Index" class="nav-link">
                            <span class="nav-icon">📋</span> Orders
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Tables/Index" class="nav-link">
                            <span class="nav-icon">🪑</span> Tables
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Customers/Index" class="nav-link">
                            <span class="nav-icon">👤</span> Customers
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Inventory/Index" class="nav-link">
                            <span class="nav-icon">📦</span> Inventory
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <small>&copy; @DateTime.Now.Year BistroGo</small>
            </div>
        </aside>

        <!-- ── Main content area ───────────────────────── -->
        <div class="main-area">
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">☰</button>
                <span class="topbar-title">@ViewData["Title"]</span>
            </header>

            <main class="content">
                @RenderBody()
            </main>

            <footer class="footer">
                <div class="container-fluid">
                    &copy; @DateTime.Now.Year - BistroGo - <a asp-page="/Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            // Toggle sidebar on mobile
            document.getElementById('sidebarToggle')?.addEventListener('click', function () {
                document.querySelector('.app-wrapper').classList.toggle('sidebar-collapsed');
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>