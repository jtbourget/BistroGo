@using BistroGo.Web.Stores
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BistroGo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BistroGo.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/introjs/introjs.min.css" />
</head>
<body>
    <div class="app-wrapper">

        <!-- ── Sidebar ─────────────────────────────────── -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <a asp-page="/Index" class="brand-link">
                    <span class="brand-emblem">🍽️</span>
                    <span class="brand-text">Bistro<span class="brand-accent">Go</span></span>
                </a>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a asp-page="/Index" class="nav-link">
                            <span class="nav-icon">🏠</span> Home
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Menu/Index" class="nav-link">
                            <span class="nav-icon">🍴</span> Menu
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav-link" data-bs-toggle="modal" data-bs-target="#currentOrderModal">
                            <span class="nav-icon">🛒</span> Cart
                            <span class="badge bg-danger rounded-pill ms-2 @(CurrentOrder.TotalItems > 0 ? "" : "d-none")"
                                  id="cartTicker">@CurrentOrder.TotalItems</span>
                        </a>
                    </li>
                    @* Hide Orders from customers/logged-out users. Only Manager and KitchenStaff can see orders. *@
                    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole(Roles.Manager) || User.IsInRole(Roles.KitchenStaff)))
                    {
                        <li>
                            <a asp-page="/Orders/Index" class="nav-link">
                                <span class="nav-icon">📋</span> Orders
                            </a>
                        </li>
                    }
                    @* Only Manager can manage inventory and generate staff logins. *@
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole(Roles.Manager))
                    {
                        <li>
                            <a asp-page="/Inventory/Index" class="nav-link">
                                <span class="nav-icon">📦</span> Manage Inventory
                            </a>
                        </li>
                        <li>
                            <a asp-page="/Account/ManageStaff" class="nav-link">
                                <span class="nav-icon">👥</span> Manage Staff
                            </a>
                        </li>
                    }
                </ul>
            </nav>
            <div class="sidebar-footer d-flex align-items-center justify-content-between px-3">
                <small>&copy; @DateTime.Now.Year BistroGo</small>
                <!-- Walkthrough for user onboarding -->
                <button type="button" id="startWalkthroughBtn" class="btn btn-sm btn-outline-secondary py-0" style="font-size: 0.75rem;">Walkthrough</button>
            </div>
        </aside>

        <!-- ── Main content area ───────────────────────── -->
        <div class="main-area">
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">☰</button>
                <partial name="_LoginPartial" />
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════
         GLOBAL CART MODAL — same modal on every page
         ═══════════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="currentOrderModal"
         tabindex="-1"
         aria-labelledby="currentOrderModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content menu-modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="currentOrderModalLabel">🛒 Shopping Cart</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="cartEmptyState" class="alert alert-info mb-0 @(CurrentOrder.Lines.Any() ? "d-none" : "")">
                        Your cart is empty. Add items from the menu to get started.
                    </div>

                    <table class="table align-middle mb-0 @(CurrentOrder.Lines.Any() ? "" : "d-none")" id="cartTable">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="text-end">Price</th>
                                <th class="text-center" style="width: 160px;">Quantity</th>
                                <th class="text-end">Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="cartTableBody">
                            @foreach (var line in CurrentOrder.Lines)
                            {
                                <tr data-menu-item-id="@line.MenuItemId">
                                    <td>@line.MenuItem?.Name</td>
                                    <td class="text-end">$@line.UnitPrice.ToString("0.00")</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary js-qty-decrease">−</button>
                                            <span class="px-2 align-self-center js-qty">@line.Quantity</span>
                                            <button type="button" class="btn btn-sm btn-outline-primary js-qty-increase">+</button>
                                        </div>
                                    </td>
                                    <td class="text-end js-line-total">$@((line.UnitPrice * line.Quantity).ToString("0.00"))</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 js-remove-line" title="Remove">✕</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Total:</td>
                                <td class="text-end card-price" id="cartTotal">$@CurrentOrder.TotalPrice.ToString("0.00")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Close</button>
                    <a asp-page="/Orders/Checkout" class="btn btn-primary">Continue to Checkout</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Walkthrough Initial Prompt Modal -->
    <div class="modal fade" id="walkthroughPromptModal" tabindex="-1" aria-labelledby="walkthroughPromptModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="walkthroughPromptModalLabel">🧭 Walkthrough</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Welcome to BistroGo! Would you like to view a guided walkthrough to learn how to use the app?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">✕ Maybe Later</button>
                    <button type="button" class="btn btn-primary" id="confirmWalkthroughBtn">👣 Start Walkthrough</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Walkthrough Complete - Button Highlight Modal -->
    <div class="modal fade" id="walkthroughCompleteModal" tabindex="-1" aria-labelledby="walkthroughCompleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="walkthroughCompleteModalLabel">✨ Walkthrough Complete!</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Great job! You can access the walkthrough anytime by clicking the <strong>Walkthrough</strong> button in the sidebar.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Got it!</button>
                </div>
            </div>
        </div>
    </div>

    <!-- CSRF token for the cart AJAX POSTs -->
    <form id="csrfForm" method="post" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/introjs/intro.min.js"></script>
    <script src="~/js/walkthrough.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            // ── Sidebar toggle (mobile) ──────────────────────────────────
            document.getElementById('sidebarToggle')?.addEventListener('click', function () {
                document.querySelector('.app-wrapper').classList.toggle('sidebar-collapsed');
            });

            // ── Cart modal AJAX (works from any page) ────────────────────
            (function () {
                const csrfToken = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]')?.value || '';
                const cartTableBody = document.getElementById('cartTableBody');
                const cartTotal = document.getElementById('cartTotal');
                const cartTable = document.getElementById('cartTable');
                const cartEmptyState = document.getElementById('cartEmptyState');

                if (!cartTableBody) return;

                cartTableBody.addEventListener('click', async function (e) {
                    const row = e.target.closest('tr');
                    if (!row) return;

                    const menuItemId = parseInt(row.getAttribute('data-menu-item-id'), 10);
                    const qtySpan = row.querySelector('.js-qty');
                    const currentQty = parseInt(qtySpan.textContent, 10);

                    let endpoint = null;
                    let body = null;

                    if (e.target.classList.contains('js-qty-increase')) {
                        endpoint = '/Menu?handler=UpdateQuantityJson';
                        body = new URLSearchParams({ menuItemId, quantity: currentQty + 1 });
                    } else if (e.target.classList.contains('js-qty-decrease')) {
                        endpoint = '/Menu?handler=UpdateQuantityJson';
                        body = new URLSearchParams({ menuItemId, quantity: currentQty - 1 });
                    } else if (e.target.classList.contains('js-remove-line')) {
                        endpoint = '/Menu?handler=RemoveLineJson';
                        body = new URLSearchParams({ menuItemId });
                    }

                    if (!endpoint) return;

                    const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': csrfToken
                        },
                        body: body.toString()
                    });

                    if (!response.ok) {
                        console.error('[Cart] Update failed:', response.status);
                        return;
                    }

                    const data = await response.json();
                    renderCart(data);
                    updateBadges(data.itemCount);
                });

                function renderCart(data) {
                    const hasLines = data.lines.length > 0;
                    cartTable.classList.toggle('d-none', !hasLines);
                    cartEmptyState.classList.toggle('d-none', hasLines);

                    cartTableBody.innerHTML = '';
                    for (const line of data.lines) {
                        const tr = document.createElement('tr');
                        tr.setAttribute('data-menu-item-id', line.menuItemId);
                        tr.innerHTML = `
                                    <td>${escapeHtml(line.itemName)}</td>
                                    <td class="text-end">$${line.unitPrice.toFixed(2)}</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary js-qty-decrease">−</button>
                                            <span class="px-2 align-self-center js-qty">${line.quantity}</span>
                                            <button type="button" class="btn btn-sm btn-outline-primary js-qty-increase">+</button>
                                        </div>
                                    </td>
                                    <td class="text-end js-line-total">$${line.total.toFixed(2)}</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 js-remove-line" title="Remove">✕</button>
                                    </td>`;
                        cartTableBody.appendChild(tr);
                    }

                    cartTotal.textContent = '$' + data.total.toFixed(2);
                }

                function updateBadges(count) {
                    // Sidebar badge
                    const cartTicker = document.getElementById('cartTicker');
                    if (cartTicker) {
                        cartTicker.textContent = count;
                        cartTicker.classList.toggle('d-none', count === 0);
                    }
                    // Menu page badge (only present on Menu)
                    const menuBadge = document.getElementById('menuCartBadge');
                    if (menuBadge) {
                        menuBadge.textContent = count;
                        menuBadge.classList.toggle('d-none', count === 0);
                    }
                }

                function escapeHtml(str) {
                    const div = document.createElement('div');
                    div.textContent = str;
                    return div.innerHTML;
                }
            })();

            // ── Walkthrough ──────────────────────────────────────────────
            document.getElementById('startWalkthroughBtn')?.addEventListener('click', function (e) {
                e.preventDefault();
                var path = window.location.pathname.toLowerCase();
                if (!path.includes('/menu')) {
                    window.location.href = '/Menu?walkthrough=true';
                    return;
                }
                startWalkthrough();
            });

            function startWalkthrough() {
                markSeen();
                var steps = [];

                var categoryEl = document.querySelector('#category');
                if (categoryEl) {
                    steps.push({
                        element: categoryEl,
                        intro: "Welcome to BistroGo! Let's get started by selecting a category to filter the menu items.",
                        position: 'right'
                    });
                }

                var addBtn = document.querySelector('.btn-add-to-order');
                if (addBtn) {
                    steps.push({
                        element: addBtn,
                        intro: "Once you find an item you like, click here to add it to your cart.",
                        position: 'top'
                    });
                }

                var cartEl = document.querySelector('a[data-bs-target="#currentOrderModal"]');
                if (cartEl) {
                    steps.push({
                        element: cartEl,
                        intro: "Click here to view your cart and proceed to checkout when you're ready.",
                        position: 'right'
                    });
                }

                if (steps.length > 0) {
                    introJs().setOptions({
                        steps: steps,
                        showProgress: true,
                        showBullets: false
                    }).oncomplete(function() {
                        // Show the completion modal with button highlight when walkthrough ends
                        showWalkthroughCompleteWithHighlight();
                    }).onexit(function() {
                        // Show the completion modal with button highlight when user exits
                        showWalkthroughCompleteWithHighlight();
                    }).start();
                } else {
                    alert("Walkthrough steps are not available on this page.");
                }
            }

            if (window.location.search.includes('walkthrough=true')) {
                setTimeout(startWalkthrough, 500);
                window.history.replaceState({}, document.title, window.location.pathname);
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>