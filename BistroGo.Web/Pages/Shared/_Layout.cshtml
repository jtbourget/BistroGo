<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BistroGo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BistroGo.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/introjs/introjs.min.css" />
</head>
<body>
    <div class="app-wrapper">

        <!-- ── Sidebar ─────────────────────────────────── -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <a asp-page="/Index" class="brand-link">
                    <span class="brand-emblem">🍽️</span>
                    <span class="brand-text">Bistro<span class="brand-accent">Go</span></span>
                </a>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a asp-page="/Index" class="nav-link">
                            <span class="nav-icon">🏠</span> Home
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Menu/Index" class="nav-link">
                            <span class="nav-icon">🍴</span> Menu
                        </a>
                    </li>
                    <!-- 
                        Shopping Cart Sidebar Item 
                        Displays the current total items added to the cart via the global CartCount.
                        Clicking this item triggers the globally accessible currentOrderModal. 
                    -->
                    <li>
                        <a href="#" class="nav-link" data-bs-toggle="modal" data-bs-target="#currentOrderModal">
                            <span class="nav-icon">🛒</span> Cart
                            @await Component.InvokeAsync("Cart", new { part = "Badge" }) <!--Cart ticker badge-->
                        </a>
                    </li>
                    @* Hide Orders from customers/logged-out users. Only Manager and KitchenStaff can see orders. *@
                    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole(Roles.Manager) || User.IsInRole(Roles.KitchenStaff)))
                    {
                        <li>
                            <a asp-page="/Orders/Index" class="nav-link">
                                <span class="nav-icon">📋</span> Orders
                            </a>
                        </li>
                    }
                    @* Only Manager can manage inventory and generate staff logins. *@
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole(Roles.Manager))
                    {
                        <li>
                            <a asp-page="/Inventory/Index" class="nav-link">
                                <span class="nav-icon">📦</span> Manage Inventory
                            </a>
                        </li>
                        <li>
                            <a asp-page="/Account/ManageStaff" class="nav-link">
                                <span class="nav-icon">👥</span> Manage Staff
                            </a>
                        </li>
                    }
                </ul>
            </nav>
            <div class="sidebar-footer d-flex align-items-center justify-content-between px-3">
                <small>&copy; @DateTime.Now.Year BistroGo</small>
                <button type="button" id="startWalkthroughBtn" class="btn btn-sm btn-outline-secondary py-0" style="font-size: 0.75rem;">Walkthrough</button>
            </div>
        </aside>

        <!-- ── Main content area ───────────────────────── -->
        <div class="main-area">
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">☰</button>
                <partial name="_LoginPartial" />
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- 
        Global Current Order Modal 
        Contains the shopping cart functionality and details.
        Moved to the shared layout so it can be invoked from any page via the Cart sidebar item.
    -->
    @await Component.InvokeAsync("Cart", new { part = "Modal" })

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/introjs/intro.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Toggle sidebar on mobile
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.querySelector('.app-wrapper').classList.toggle('sidebar-collapsed');
        });

        // --- Walkthrough Feature ---
        // Attaches a click event to the walkthrough button in the footer.
        // If the user is not currently on the Menu page, it redirects them there
        // with a query string 'walkthrough=true' to trigger it after the page loads.
        document.getElementById('startWalkthroughBtn')?.addEventListener('click', function(e) {
            e.preventDefault();
            var path = window.location.pathname.toLowerCase();
            if (!path.includes('/menu')) {
                window.location.href = '/Menu?walkthrough=true';
                return;
            }
            startWalkthrough();
        });

        // Initializes and starts the Intro.js walkthrough tour.
        // Dynamically builds the steps array to ensure elements exist on the page
        // before attaching a tooltip to them, preventing silent failures.
        function startWalkthrough() {
            var steps = [];
            
            // Step 1: Highlight the category filter dropdown
            var categoryEl = document.querySelector('#category');
            if (categoryEl) {
                steps.push({
                    element: categoryEl,
                    intro: "Welcome to BistroGo! Let's get started by selecting a category to filter the menu items.",
                    position: 'right'
                });
            }

            // Step 2: Highlight the first 'Add to Order' button on a menu item
            var addBtn = document.querySelector('.btn-add-to-order');
            if (addBtn) {
                steps.push({
                    element: addBtn,
                    intro: "Once you find an item you like, click here to add it to your cart.",
                    position: 'top'
                });
            }

            // Step 3: Highlight the Cart button in the sidebar
            var cartEl = document.querySelector('a[data-bs-target="#currentOrderModal"]');
            if (cartEl) {
                steps.push({
                    element: cartEl,
                    intro: "Click here to view your cart and proceed to checkout when you're ready.",
                    position: 'right'
                });
            }

            // Execute the tour only if there is at least one step available
            if (steps.length > 0) {
                introJs().setOptions({
                    steps: steps,
                    showProgress: true,
                    showBullets: false
                }).start();
            } else {
                alert("Walkthrough steps are not available on this page.");
            }
        }

        // Auto-start the walkthrough if redirected from another page.
        // Uses a slight timeout to ensure all DOM elements and layout are fully rendered.
        if (window.location.search.includes('walkthrough=true')) {
            setTimeout(startWalkthrough, 500);
            
            // Clean up the URL to remove the query parameter so refreshing the page
            // doesn't immediately restart the walkthrough again.
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>